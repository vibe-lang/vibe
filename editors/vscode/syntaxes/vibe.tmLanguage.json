{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vibe",
  "scopeName": "source.vibe",
  "patterns": [
    {"include": "#comments"},
    {"include": "#keywords"},
    {"include": "#strings"},
    {"include": "#numbers"},
    {"include": "#constants"},
    {"include": "#operators"},
    {"include": "#functions"},
    {"include": "#types"},
    {"include": "#struct-name"},
    {"include": "#variables"}
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.vibe",
          "match": "#.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.vibe",
          "match": "\\b(if|elsif|else|end|for|in|while|break|continue|return|try|catch|throw|import)\\b"
        },
        {
          "name": "keyword.other.vibe",
          "match": "\\b(def|fn|let|struct)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.vibe",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.vibe",
              "match": "\\\\[\\\\\"nrt0]"
            },
            {
              "name": "meta.embedded.expression.vibe",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {"name": "punctuation.section.interpolation.begin.vibe"}
              },
              "endCaptures": {
                "0": {"name": "punctuation.section.interpolation.end.vibe"}
              },
              "patterns": [
                {"include": "source.vibe"}
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.vibe",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.vibe",
              "match": "\\\\[\\\\']"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.vibe",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.vibe",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.vibe",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.nil.vibe",
          "match": "\\b(nil)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.vibe",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.vibe",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.arithmetic.vibe",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.assignment.vibe",
          "match": "="
        },
        {
          "name": "keyword.operator.range.vibe",
          "match": "(\\.\\.\\.|\\.\\.)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.definition.vibe",
          "match": "(?<=\\bdef\\s)[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "support.function.builtin.vibe",
          "match": "\\b(puts|print|len|type|push|pop|first|last|rest|append|to_s|to_i|to_f|input|exit|map|filter|each|sort|reverse|contains|keys|values|split|join|replace|trim|abs|min|max|string_length|read_file|write_file|file_exists)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.vibe",
          "match": "\\b(int|float|string|boolean)\\b"
        }
      ]
    },
    "struct-name": {
      "patterns": [
        {
          "name": "entity.name.type.struct.vibe",
          "match": "(?<=\\bstruct\\s)[A-Z][a-zA-Z0-9_]*"
        },
        {
          "name": "entity.name.type.vibe",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.vibe",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
