{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    {"open": "{", "close": "}"},
    {"open": "[", "close": "]"},
    {"open": "(", "close": ")"},
    {"open": "\"", "close": "\""},
    {"open": "'", "close": "'"}
  ],
  "surroundingPairs": [
    {"open": "{", "close": "}"},
    {"open": "[", "close": "]"},
    {"open": "(", "close": ")"},
    {"open": "\"", "close": "\""},
    {"open": "'", "close": "'"}
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(def|if|elsif|else|for|while|struct|try|catch)\\b",
      "end": "^\\s*end\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(def|if|elsif|else|for|while|struct|try|catch)\\b.*$",
    "decreaseIndentPattern": "^\\s*(end|elsif|else|catch)\\b"
  },
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_]*[?!]?"
}
